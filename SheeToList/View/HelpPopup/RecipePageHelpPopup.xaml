<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SheeToList.View.HelpPopup.RecipePageHepPopup"
            xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource BackgroundSecondary}}">

    <toolkit:Popup.Resources>
        <Style x:Key="VerticalLayoutBackground" TargetType="VerticalStackLayout" >
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource BackgroundSecondary}}" />
            <Setter Property="Spacing" Value="10"/>
        </Style>
        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource WhiteText}}" />
        </Style>
    </toolkit:Popup.Resources>

    <ScrollView HeightRequest="480" WidthRequest="320" Padding="0">
        <VerticalStackLayout Style="{StaticResource VerticalLayoutBackground}"
                       Padding="0">

            <Label 
      Text="Ce popup est la pour vous aidé à utiliser l'application."
      VerticalOptions="Start" 
      HorizontalOptions="Center"
      Style="{StaticResource LabelStyle}"/>

            <Label
                Text="En touchant le nom de la recette en haut de l'écran, vous pouvez modifier le nom de cette recette."
                Style="{StaticResource LabelStyle}"/>

            <Image Source="recipeingrediant.png" HeightRequest="100" WidthRequest="300" 
       Aspect="AspectFit"/>
            <Label
                Text="Sur cette ligne, vous voyez les informations sur 1 ingrédient. 
                &#10;Vous pouvez modifier son nom, sa catégorie ou la quantité. Vous pouvez supprimer l'ingrédient en touchant la poubelle.
                &#10;Si la catégorie d'un ingrédient reste à 'Autre', alors l'application se chargera du triage de l'ingrédient, mais cela peut entraîner des erreurs.
                "
                Style="{StaticResource LabelStyle}"/>

        </VerticalStackLayout>
    </ScrollView>
</toolkit:Popup>