<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="SheeToList.View.HelpPopup.MainHelpPopup"
                 BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource BackgroundSecondary}}" >

    <toolkit:Popup.Resources>
        <Style x:Key="ButtonColor" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource BackgroundPrimary}}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource WhiteText}}" />
        </Style>
        <Style x:Key="VerticalLayoutBackground" TargetType="VerticalStackLayout" >
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource BackgroundSecondary}}" />
            <Setter Property="Spacing" Value="10"/>
        </Style>
        <Style x:Key="StackLayoutBackground" TargetType="StackLayout" >
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource BackgroundSecondary}}" />
            <Setter Property="Spacing" Value="8"/>
        </Style>
        <Style x:Key="PickerStyle" TargetType="Picker">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource BackgroundPrimary}}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource WhiteText}}" />
        </Style>
        <Style x:Key="EntryStyle" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource BackgroundPrimary}}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource WhiteText}}" />
        </Style>
        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource WhiteText}}" />
        </Style>
    </toolkit:Popup.Resources>

    <ScrollView HeightRequest="480" WidthRequest="320" Padding="0">
        <VerticalStackLayout Style="{StaticResource VerticalLayoutBackground}"
                           Padding="0">

            <Label 
            Text="Ce popup est la pour vous aidé à utiliser l'application."
            VerticalOptions="Start" 
            HorizontalOptions="Center"
            Style="{StaticResource LabelStyle}"/>

            <Image Source="maintopscreen.png" HeightRequest="200" WidthRequest="300" 
                   Aspect="AspectFit"/>

            <Label Text="Ceci est la barre du dessus. Vous y retrouverez les boutons qui vous amèneront à la liste des recettes et des catégories.                  
                   &#10;En dessous, vous avez la liste des courses classée par catégorie.
                   &#10;Ici, la pomme est classée dans les fruits. 
                   &#10;Appuyez sur la poubelle pour supprimer le produit de la liste. Cochez la case pour indiquer que vous l'avez ajouté à votre caddie." 
                   Style="{StaticResource LabelStyle}"/>

            <Image Source="mainbottombar.png" HeightRequest="100" WidthRequest="300" Aspect="AspectFit"/>

            <Label Text="Ceci est la barre du bas. Grâce au bouton proposé :
                   &#10;Pour ajouter un produit à la liste de course : appuyez sur le '+' afin d'ouvrir la fenêtre qui vous permettra de renseigner le nom et la quantité.
                   &#10;Si vous souhaitez effacer toute la liste, appuyez sur le bouton 'X'.
                   &#10;Le bouton 'Révelez tout' affichera les produits que vous avez cochés. R'appuyez dessus pour les masquer à nouveau."
                   Style="{StaticResource LabelStyle}"/>

        </VerticalStackLayout>
    </ScrollView>
</toolkit:Popup>