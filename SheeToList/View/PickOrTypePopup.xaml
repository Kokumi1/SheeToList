<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="SheeToList.View.PickOrTypePopup"
               BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource BackgroundSecondary}}" >

    <toolkit:Popup.Resources>
        <Style x:Key="ButtonColor" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource BackgroundPrimary}}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource WhiteText}}" />
        </Style>
        <Style x:Key="VerticalLayoutBackground" TargetType="VerticalStackLayout" >
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource BackgroundSecondary}}" />
            <Setter Property="Spacing" Value="10"/>
        </Style>
        <Style x:Key="StackLayoutBackground" TargetType="StackLayout" >
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource BackgroundSecondary}}" />
            <Setter Property="Spacing" Value="8"/>
        </Style>
        <Style x:Key="PickerStyle" TargetType="Picker">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource BackgroundPrimary}}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource WhiteText}}" />
        </Style>
        <Style x:Key="EntryStyle" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource BackgroundPrimary}}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource WhiteText}}" />
        </Style>
        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource WhiteText}}" />
        </Style>
    </toolkit:Popup.Resources>

    <VerticalStackLayout WidthRequest="320" Style="{StaticResource VerticalLayoutBackground}">
        <Label x:Name="MessageText" VerticalOptions="Center" Style="{StaticResource LabelStyle}"/>

        <!-- Tabs -->
        <Grid ColumnDefinitions="*,*">
            <Button x:Name="BtnType" Text="Saisir" Grid.Column="0" 
                        Clicked="OnTabClicked" Style="{StaticResource ButtonColor}"
                        />
            <Button x:Name="BtnPick" Text="Choisir" Grid.Column="1" 
                        Clicked="OnTabClicked" Style="{StaticResource ButtonColor}"/>
        </Grid>

        <!-- Panels -->
        <StackLayout x:Name="TypePanel" Style="{StaticResource StackLayoutBackground}" HeightRequest="500">
            <Label Text="{Binding typeLabel}" FontAttributes="Bold" Style="{StaticResource LabelStyle}"/>
            <Entry x:Name="EntryName" Placeholder="{Binding TypePlaceholder}" Style="{StaticResource EntryStyle}" TextChanged="EntryName_TextChanged"/>

            <!-- quantity -->
            <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="{Binding QuantityLabel}" FontAttributes="Bold" 
                       VerticalTextAlignment="Center" Style="{StaticResource LabelStyle}" Padding="10"/>
                <Entry Text="{Binding Quantity}" Keyboard="Numeric" Style="{StaticResource EntryStyle}" TextChanged="QuantityEntry_TextChanged" />
                <Picker x:Name="PickerUnit" Title="{Binding UnitPlaceholder}" SelectedIndexChanged="PickerUnit_SelectedIndexChanged" 
                        Style="{StaticResource PickerStyle}"/>
            </HorizontalStackLayout>

            <!-- Suggestion-->
            <Border
            Stroke="{AppThemeBinding Light={StaticResource BackgroundPrimary}, Dark={StaticResource White}}"
                StrokeShape="RoundRectangle 10,10,10,10">
                <CollectionView
                x:Name="SuggestionsList"
                IsVisible="True"
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource BackgroundPrimary}}"
                
                SelectionMode="Single"
                SelectionChanged="SuggestionsList_SelectionChanged">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <HorizontalStackLayout Padding="10" VerticalOptions="Center" >
                                <Label Text="{Binding Name}" Padding="10" Style="{StaticResource LabelStyle}"  />
                                <Label Text="{Binding Category}" Padding="10" Style="{StaticResource LabelStyle}" />
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="SuggestionTapped" />
                                </HorizontalStackLayout.GestureRecognizers>
                            </HorizontalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

            <Label Text="Catégories" FontAttributes="Bold" Style="{StaticResource LabelStyle}" Margin="0,10,0,0"/>
            <Picker x:Name="PickerCategoryList" Title="Sélectionner..." SelectedIndexChanged="PickerCategoryList_SelectedIndexChanged" Style="{StaticResource PickerStyle   }"/>
        </StackLayout>

        <!-- pick panel -->
        <StackLayout x:Name="PickPanel" IsVisible="False" Style="{StaticResource StackLayoutBackground}">
            <Label Text="Choisir dans la liste" FontAttributes="Bold" Style="{StaticResource LabelStyle}"/>
            <Picker x:Name="PickerList" Title="{Binding PopupTitle}" SelectedIndexChanged="PickerList_SelectedIndexChanged" 
                    Style="{StaticResource PickerStyle}"/>
        </StackLayout>

        <!-- Buttons -->
        <HorizontalStackLayout Spacing="8" HorizontalOptions="End" BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource BackgroundSecondary}}" >
            <Button Text="Annuler" Clicked="OnCancelClicked"  Style="{StaticResource ButtonColor}"/>
            <Button Text="Valider" Clicked="OnAcceptClicked"  Style="{StaticResource ButtonColor}"/>
        </HorizontalStackLayout>

    </VerticalStackLayout>
</toolkit:Popup>