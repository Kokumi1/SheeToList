<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SheeToList.View.CategoryListPage"
             Title="{Binding PageTitle}">

    <Grid RowDefinitions="50,*,Auto,50" Padding="30,0">
        <CollectionView x:Name="CategoryList"
                    Grid.Row="1"
                    ItemsSource="{Binding Categories}"
                    SelectionMode="Single"
                    SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                   >
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10" ColumnDefinitions="*,Auto">
                        <Border Stroke="{StaticResource PrimaryDark}" StrokeShape="RoundRectangle 10,10,10,10"/>
                        <Label Text="{Binding Name}" VerticalOptions="Center"  Margin="10">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer 
                                        Command="{Binding BindingContext.OpenDetailCommand, Source={x:Reference CategoryList}}"
                                        CommandParameter="{Binding .}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>